SUPABASE_URL=https://xgjmfmypoadblvzlmfqh.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Server-only (never SUPABASE_PUBLISHABLE_KEY)
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=          # gemini (default) | anthropic | fake (tests; refused in production)
GEMINI_API_KEY=       # Google AI Studio key (Gemini)
GEMINI_MODEL=         # optional, default gemini-3.8-flash
GEMINI_FALLBACK_MODEL= # optional, tried on 429/503, default gemini-3.5-flash-lite
AI_API_KEY=           # Anthropic API key (only with AI_PROVIDER=anthropic)
AI_MODEL=             # optional, Anthropic model
INTERNAL_JOB_SECRET=  # ≥16 chars; authorizes /api/internal/jobs/*
CRON_SECRET=          # on Vercel: Vercel Cron sends it as a Bearer token
VAPID_PUBLIC_KEY=              # web push (ADR 0043): npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=             # server-only
VAPID_SUBJECT=                 # mailto: or https: contact for push services
NOTION_CLIENT_ID=              # 단어장 (ADR 0046): Notion public integration
NOTION_CLIENT_SECRET=          # server-only
NOTION_REDIRECT_URI=           # optional, default <origin>/api/notion/callback
NOTION_TOKEN_KEY=              # openssl rand -base64 32; encrypts Notion tokens at rest
NOTION_GATEWAY=                # optional: fake (dev/E2E only; refused in production)

# E2E only — set in your shell, never in a committed file:
#   E2E_EMAIL=... E2E_PASSWORD=... npm run test:e2e
